import xml.etree.ElementTree as ET, os, glob

dirs = ['/etc/skel', '/root'] + glob.glob('/home/*')
for base in dirs:
    path = os.path.join(base, '.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-keyboard-shortcuts.xml')
