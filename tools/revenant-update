    root = None
    if os.path.exists(path):
        try:
            tree = ET.parse(path)
            root = tree.getroot()
        except Exception:
            root = None
    if root is None:
        root = ET.Element('channel', attrib={'name': 'xfce4-keyboard-shortcuts', 'version': '1.0'})
        tree = ET.ElementTree(root)
    
    cmd_prop = root.find(\"./property[@name='commands']\")
    if cmd_prop is None:
        cmd_prop = ET.SubElement(root, 'property', attrib={'name': 'commands', 'type': 'empty'})
    custom_prop = cmd_prop.find(\"./property[@name='custom']\")
    if custom_prop is None:
        custom_prop = ET.SubElement(cmd_prop, 'property', attrib={'name': 'custom', 'type': 'empty'})
    
