#!/bin/bash
# ==============================================================================
# Revenant OS - Intelligent Over-The-Air (OTA) System & Agent Updater
# ==============================================================================
# Upgrades:
#   1. Agent Core (OmniRoute, OpenInterpreter, OpenViking, Hermes Agent)
#   2. Offline Neural TTS Voice Models (Piper)
#   3. System Scripts, Themes, Plymouth Splash, and Desktop Configurations
#   4. Upstream Linux Kernel & Security Patches
# ==============================================================================

# Disable strict exit-on-error so non-critical sub-commands never abort the update pipeline
set +e

REPO_OWNER="Fixitdaz"
REPO_NAME="revenant-os"
RAW_BASE="https://raw.githubusercontent.com/$REPO_OWNER/$REPO_NAME/main"
RAW_FALLBACK="https://github.com/$REPO_OWNER/$REPO_NAME/raw/main"
LOCAL_VERSION_FILE="/etc/revenant/version.json"

CYAN="\033[96m"
GREEN="\033[92m"
YELLOW="\033[93m"
RED="\033[91m"
RESET="\033[0m"
BOLD="\033[1m"

echo -e "${CYAN}${BOLD}"
echo "=========================================================="
echo "           REVENANT OS - SYSTEM & AGENT UPDATER           "
echo "=========================================================="
echo -e "${RESET}"

if [ "$EUID" -ne 0 ]; then
  echo -e "${RED}[!] Please run as root: sudo revenant-update${RESET}"
  exit 1
fi

CHECK_ONLY=false
FORCE=false

for arg in "$@"; do
  case "$arg" in
    --check|-c)
      CHECK_ONLY=true
      ;;
    --force|-f)
      FORCE=true
      ;;
    --help|-h)
      echo "Usage: sudo revenant-update [OPTIONS]"
      echo ""
      echo "Options:"
      echo "  -c, --check    Check for available updates without applying them"
      echo "  -f, --force    Force re-application of all updates and agent dependencies"
      echo "  -h, --help     Show this help message"
      exit 0
      ;;
  esac
done

echo -e "${CYAN}[*] Testing internet connectivity...${RESET}"
if ! curl -s --head --connect-timeout 5 https://github.com >/dev/null; then
  echo -e "${RED}[!] Internet connection failed. Please connect to a network and try again.${RESET}"
  exit 1
fi
echo -e "${GREEN}[✓] Online connection verified.${RESET}"

# Self-update check: ensure the OTA updater script is always running the latest version from GitHub
if [ "$REVENANT_UPDATED" != "1" ]; then
  echo -e "${CYAN}[*] Checking for latest OTA updater script from GitHub...${RESET}"
  if curl -fsSL -H "Cache-Control: no-cache" --connect-timeout 5 "$RAW_BASE/tools/revenant-update" -o /tmp/revenant-update.new 2>/dev/null || \
     curl -fsSL -L -H "Cache-Control: no-cache" --connect-timeout 5 "$RAW_FALLBACK/tools/revenant-update" -o /tmp/revenant-update.new 2>/dev/null; then
    if [ -s /tmp/revenant-update.new ] && ! cmp -s /tmp/revenant-update.new "/usr/local/bin/revenant-update" 2>/dev/null; then
      cp /tmp/revenant-update.new /usr/local/bin/revenant-update
      chmod +x /usr/local/bin/revenant-update
      rm -f /tmp/revenant-update.new
      echo -e "${GREEN}[✓] OTA updater updated itself to latest release. Re-executing...${RESET}"
      export REVENANT_UPDATED=1
      exec /usr/local/bin/revenant-update "$@"
    fi
  fi
  rm -f /tmp/revenant-update.new
fi

mkdir -p /etc/revenant
if [ ! -f "$LOCAL_VERSION_FILE" ]; then
  cat << 'EOF' > "$LOCAL_VERSION_FILE"
{
  "os_name": "Revenant OS",
  "version": "1.0.0-rc15.6",
  "build": "15.6",
  "release_date": "2026-09-05"
}
EOF
fi

CURRENT_VER=$(grep -oP '"version":\s*"\K[^"]+' "$LOCAL_VERSION_FILE" 2>/dev/null || echo "1.0.0")
CURRENT_BUILD=$(grep -oP '"build":\s*"?\K[0-9]+(\.[0-9]+)?' "$LOCAL_VERSION_FILE" 2>/dev/null || echo "15.6")

echo -e "${CYAN}[*] Current Installed Version: ${BOLD}v$CURRENT_VER (Build $CURRENT_BUILD)${RESET}"
echo -e "${CYAN}[*] Querying remote release manifest from GitHub...${RESET}"

REMOTE_MANIFEST=$(curl -fsSL -H "Cache-Control: no-cache" --connect-timeout 10 "$RAW_BASE/version.json" 2>/dev/null || \
                  curl -fsSL -L -H "Cache-Control: no-cache" --connect-timeout 10 "$RAW_FALLBACK/version.json" 2>/dev/null || true)

if [ -z "$REMOTE_MANIFEST" ]; then
  echo -e "${YELLOW}[!] Could not fetch remote manifest (repository may be private or offline).${RESET}"
  echo -e "${CYAN}[*] Proceeding with live component synchronization mode...${RESET}"
  REMOTE_BUILD="$CURRENT_BUILD"
else
  REMOTE_VER=$(echo "$REMOTE_MANIFEST" | grep -oP '"version":\s*"\K[^"]+' 2>/dev/null || echo "$CURRENT_VER")
  REMOTE_BUILD=$(echo "$REMOTE_MANIFEST" | grep -oP '"build":\s*"?\K[0-9]+(\.[0-9]+)?' 2>/dev/null || echo "$CURRENT_BUILD")
  echo -e "${CYAN}[*] Latest Remote Version:    ${BOLD}v$REMOTE_VER (Build $REMOTE_BUILD)${RESET}"
fi

if [ "$CHECK_ONLY" = true ]; then
  if [ "$REMOTE_BUILD" != "$CURRENT_BUILD" ]; then
    echo -e "${GREEN}[✓] A new update is available: Build $REMOTE_BUILD (Installed: $CURRENT_BUILD)${RESET}"
    echo -e "Run 'sudo revenant-update' to install."
    exit 0
  else
    echo -e "${GREEN}[✓] System is up to date.${RESET}"
    exit 0
  fi
fi

# TIER 0: Login Greeter & Desktop Account Selection (Purge Stuck Autologin)
echo ""
echo -e "${CYAN}${BOLD}[0/5] Configuring LightDM Login Screen & Account Selection...${RESET}"
# Purge Debian live-config daemon so it cannot force or regenerate autologin on reboot
apt-get purge -y live-boot live-boot-doc live-config live-config-doc live-config-systemd live-tools 2>/dev/null || true
systemctl disable live-config.service 2>/dev/null || true
systemctl mask live-config.service 2>/dev/null || true
rm -rf /lib/live /var/lib/live

# Remove all autologin conf overrides
rm -f /etc/lightdm/lightdm.conf.d/*autologin*.conf
rm -f /etc/lightdm/lightdm.conf.d/*live*.conf
rm -f /etc/lightdm/lightdm.conf.d/*debian*.conf
rm -f /usr/share/lightdm/lightdm.conf.d/*live*.conf
rm -f /usr/share/lightdm/lightdm.conf.d/*autologin*.conf

# Comment out any autologin lines in lightdm configs
sed -i -E 's/^[[:space:]]*autologin-user[[:space:]]*=.*/#autologin-user=/' /etc/lightdm/lightdm.conf 2>/dev/null || true
sed -i -E 's/^[[:space:]]*autologin-user-timeout[[:space:]]*=.*/#autologin-user-timeout=/' /etc/lightdm/lightdm.conf 2>/dev/null || true
for cf in /etc/lightdm/lightdm.conf.d/*.conf /usr/share/lightdm/lightdm.conf.d/*.conf; do
  if [ -f "$cf" ]; then
    sed -i -E 's/^[[:space:]]*autologin-user[[:space:]]*=.*/#autologin-user=/' "$cf" 2>/dev/null || true
    sed -i -E 's/^[[:space:]]*autologin-user-timeout[[:space:]]*=.*/#autologin-user-timeout=/' "$cf" 2>/dev/null || true
  fi
done

# Explicitly configure LightDM greeter to show user list and session picker
mkdir -p /etc/lightdm/lightdm.conf.d
cat << 'GREETER_EOF' > /etc/lightdm/lightdm.conf.d/01-revenant-greeter.conf
[Seat:*]
autologin-user=
autologin-guest=false
greeter-session=lightdm-gtk-greeter
greeter-hide-users=false
greeter-show-manual-login=true
user-session=xfce
GREETER_EOF

# Ensure registered session files exist for both XFCE and i3 in LightDM
mkdir -p /usr/share/xsessions
cat << 'I3_XSESSION' > /usr/share/xsessions/i3.desktop
[Desktop Entry]
Name=i3
Comment=improved dynamic tiling window manager
Exec=i3
TryExec=i3
Type=Application
DesktopNames=i3
Keywords=tiling;wm;windowmanager;window;manager;
I3_XSESSION

if [ ! -f /usr/share/xsessions/xfce.desktop ] && [ -f /usr/share/xsessions/xubuntu.desktop ]; then
  cp /usr/share/xsessions/xubuntu.desktop /usr/share/xsessions/xfce.desktop
fi

echo -e "${GREEN}[✓] LightDM login screen restored: prompt for user selection and desktop session on startup.${RESET}"

# TIER 1: Offline Local Inference Engine (llama-server & Qwen 2.5)
echo ""
echo -e "${CYAN}${BOLD}[1/5] Configuring Offline Local Inference Engine...${RESET}"
mkdir -p /opt/llama.cpp /opt/models

if [ ! -f /opt/llama.cpp/llama-server ] || [ "$FORCE" = true ]; then
  echo -e "${CYAN}  -> Downloading static llama-server binary...${RESET}"
  mkdir -p /tmp/llama_bin
  curl -fsSL -o /tmp/llama_bin/llama-server.tar.gz https://github.com/ggerganov/llama.cpp/releases/download/b10816/llama-b10816-bin-ubuntu-x64.tar.gz || true
  if [ -f /tmp/llama_bin/llama-server.tar.gz ]; then
    tar -xzf /tmp/llama_bin/llama-server.tar.gz -C /tmp/llama_bin/ || true
    find /tmp/llama_bin -name "llama-server" -exec cp {} /opt/llama.cpp/llama-server \; || true
    chmod +x /opt/llama.cpp/llama-server || true
    rm -rf /tmp/llama_bin
  fi
fi

if [ ! -f /opt/models/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf ] || [ "$FORCE" = true ]; then
  echo -e "${CYAN}  -> Downloading Qwen2.5-Coder-1.5B (Q4_K_M GGUF, ~1.04GB)...${RESET}"
  curl -L --progress-bar -o /opt/models/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf \
    https://huggingface.co/Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF/resolve/main/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf || true
fi

cat << 'SVCEOF' > /etc/systemd/system/llama-server.service
[Unit]
Description=Revenant OS Local Llama Inference Server
After=network.target

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/opt/llama.cpp
ExecStart=/opt/llama.cpp/llama-server --model /opt/models/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf --alias qwen2.5-coder-1.5b-instruct --host 127.0.0.1 --port 8080 --ctx-size 2048 --threads 2 -np 1 --no-cache-prompt -sps 0 --n-gpu-layers 0
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
SVCEOF

pkill -9 -f llama-server 2>/dev/null || true
systemctl daemon-reload
systemctl enable llama-server.service 2>/dev/null || true
systemctl restart llama-server.service 2>/dev/null || true
echo -e "${GREEN}[✓] Local inference server configured on http://127.0.0.1:8080/v1 (2K context, no-cache-prompt, zero stutter golden config)${RESET}"

# TIER 2: OpenViking Memory Daemon & Agent Core
echo ""
echo -e "${CYAN}${BOLD}[2/5] Priming OpenViking Context Memory & Agent Stack...${RESET}"
# Fast bounded check for agent packages without locking indefinitely
if timeout 15s pip3 install --break-system-packages --upgrade open-interpreter openviking >/dev/null 2>&1; then
  echo -e "${GREEN}[✓] Python agent packages synchronized.${RESET}"
else
  echo -e "${YELLOW}[!] Fast package sync completed / using cached offline packages.${RESET}"
fi

cat << 'VKEOF' > /etc/systemd/system/openviking.service
[Unit]
Description=OpenViking Automated Agent Context & Memory Daemon
After=llama-server.service

[Service]
Type=simple
ExecStart=/usr/local/bin/ov daemon --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5
User=root
Environment=OPENAI_API_BASE=http://127.0.0.1:8080/v1
Environment=OPENAI_API_KEY=sk-local-revenant

[Install]
WantedBy=multi-user.target
VKEOF

systemctl daemon-reload
systemctl enable openviking.service 2>/dev/null || true
systemctl restart openviking.service 2>/dev/null || true

# Pre-configure environment defaults so Hermes and Interpreter use local llama-server
sed -i '/OPENAI_API_BASE/d' /etc/environment 2>/dev/null || true
sed -i '/OPENAI_API_KEY/d' /etc/environment 2>/dev/null || true
echo 'OPENAI_API_BASE="http://127.0.0.1:8080/v1"' >> /etc/environment
echo 'OPENAI_API_KEY="sk-local-revenant"' >> /etc/environment

# Patch Hermes Agent hardcoded minimum context floor if present
if [ -f /usr/lib/node_modules/hermes-agent/runtime/hermes-agent/agent/model_metadata.py ]; then
  sed -i 's/MINIMUM_CONTEXT_LENGTH = 64_000/MINIMUM_CONTEXT_LENGTH = 4_000/g' /usr/lib/node_modules/hermes-agent/runtime/hermes-agent/agent/model_metadata.py
  sed -i 's/MINIMUM_CONTEXT_LENGTH = 8_000/MINIMUM_CONTEXT_LENGTH = 4_000/g' /usr/lib/node_modules/hermes-agent/runtime/hermes-agent/agent/model_metadata.py
fi

# Update Hermes config templates with 4k context_length and auxiliary compression overrides
for u_home in /root /etc/skel /home/*; do
  if [ -d "$u_home" ]; then
    mkdir -p "$u_home/.hermes"
    cat << 'HERMES_UPDATE_CFG' > "$u_home/.hermes/config.yaml"
model:
  default: "qwen2.5-coder-1.5b-instruct"
  provider: "custom"
  base_url: "http://127.0.0.1:8080/v1"
  context_length: 4096
custom_providers:
  - name: "local"
    base_url: "http://127.0.0.1:8080/v1"
    models:
      qwen2.5-coder-1.5b-instruct:
        context_length: 4096
auxiliary:
  compression:
    model: "qwen2.5-coder-1.5b-instruct"
    context_length: 4096
toolsets:
  - "hermes-cli"
HERMES_UPDATE_CFG
    cat << 'HERMES_UPDATE_ENV' > "$u_home/.hermes/.env"
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=sk-local-revenant
HERMES_UPDATE_ENV
    u_owner=$(stat -c '%u:%g' "$u_home" 2>/dev/null || echo "1000:1000")
    chown -R "$u_owner" "$u_home/.hermes" 2>/dev/null || true
  fi
done

echo -e "${GREEN}[✓] OpenViking memory daemon and Hermes 4K configuration synchronized.${RESET}"

# TIER 3: Universal 'ai' Command (Offline Local Integration)
echo ""
echo -e "${CYAN}${BOLD}[3/5] Updating Universal Terminal AI Command (/usr/local/bin/ai)...${RESET}"
cat << 'PYEOF' > /usr/local/bin/ai
#!/usr/bin/env python3
import sys, json, urllib.request, subprocess

if len(sys.argv) < 2:
    print("\033[93mUsage: ai <your question or command>\033[0m")
    print("Runs 100% locally via Qwen2.5-Coder on llama-server (port 8080).")
    sys.exit(1)

prompt = " ".join(sys.argv[1:])
print("\033[96m[Revenant Core: Local Qwen2.5 Thinking (Offline Toughbook CPU)...]\033[0m")

payload = json.dumps({
    "model": "qwen2.5-coder-1.5b-instruct",
    "messages": [
        {"role": "system", "content": "You are the Revenant OS AI Assistant on a Panasonic Toughbook. Give clear, expert Linux and computing answers."},
        {"role": "user", "content": prompt}
    ],
    "temperature": 0.6,
    "max_tokens": 512
}).encode('utf-8')

req = urllib.request.Request(
    "http://127.0.0.1:8080/v1/chat/completions",
    data=payload,
    headers={"Content-Type": "application/json"}
)

try:
    with urllib.request.urlopen(req, timeout=120) as resp:
        res = json.loads(resp.read().decode('utf-8'))
        answer = res["choices"][0]["message"]["content"]
        print("\n" + answer + "\n")
        
        # Strip special characters for Piper TTS
        clean = answer.replace('*', '').replace('`', '').replace('#', '').replace('_', '').replace('"', '').replace("'", "")
        # Speak response aloud asynchronously
        cmd = f"echo '{clean}' | /opt/piper/piper -m /opt/piper/models/en_US-lessac-medium.onnx --output_raw | aplay -r 22050 -f S16_LE -t raw -"
        subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
except Exception as e:
    print(f"\033[91m[!] Local Engine Error: {e}\033[0m")
    print("Make sure llama-server is running: sudo systemctl status llama-server")
PYEOF
chmod +x /usr/local/bin/ai

# Install/Update 'Start AI Stack & Diagnostics' helper and desktop launcher
cat << 'STARTEOF' > /usr/local/bin/revenant-services
#!/bin/bash
clear
echo -e "\033[96m\033[1m==========================================================\033[0m"
echo -e "\033[96m\033[1m    REVENANT OS - LOCAL AI ENGINE & BACKGROUND STACK     \033[0m"
echo -e "\033[96m\033[1m==========================================================\033[0m"
echo ""
echo -e "\033[96m[*] Checking & Restarting llama-server.service...\033[0m"
sudo systemctl daemon-reload
sudo systemctl restart llama-server.service 2>/dev/null || sudo systemctl start llama-server.service 2>/dev/null || true
sudo systemctl restart openviking.service 2>/dev/null || sudo systemctl start openviking.service 2>/dev/null || true

echo -e "\033[96m[*] Waiting for local model endpoint (http://127.0.0.1:8080/v1)...\033[0m"
READY=false
for i in {1..15}; do
  if curl -s http://127.0.0.1:8080/v1/models >/dev/null 2>&1; then
    READY=true
    break
  fi
  sleep 1
  echo -n "."
done
echo ""

if [ "$READY" = true ]; then
  echo -e "\033[92m\033[1m[✓] Local AI Engine is ACTIVE and ready on port 8080!\033[0m"
else
  echo -e "\033[93m[!] llama-server is initializing in the background.\033[0m"
fi

echo ""
echo -e "\033[96m\033[1mService Status Overview:\033[0m"
echo -n "  • llama-server: "
systemctl is-active llama-server.service
echo -n "  • openviking:   "
systemctl is-active openviking.service

echo ""
echo -e "\033[92m\033[1mHow to interact with your local AI:\033[0m"
echo "  1. Universal CLI:   ai \"What is the IP address of this machine?\""
echo "  2. Autonomous Agent: hermes"
echo "  3. OpenInterpreter:  interpreter"
echo ""
echo -e "Press [Enter] to launch an interactive Hermes session, or Ctrl+C to exit..."
read -r
hermes
STARTEOF
chmod +x /usr/local/bin/revenant-services

for ddir in /etc/skel/Desktop /root/Desktop /home/*/Desktop; do
  if [ -d "$ddir" ]; then
    cat << 'DESKEOF' > "$ddir/Start_AI_Engine.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Name=Start AI Engine & Services
Comment=Start local inference engine, OpenViking, and open terminal AI
Exec=xfce4-terminal --title="Revenant AI Engine Controller" -e "/usr/local/bin/revenant-services"
Icon=utilities-system-monitor
Terminal=false
StartupNotify=true
Categories=System;Utility;Development;
DESKEOF
    chmod +x "$ddir/Start_AI_Engine.desktop"
    u_owner=$(stat -c '%u:%g' "$ddir" 2>/dev/null || echo "1000:1000")
    chown "$u_owner" "$ddir/Start_AI_Engine.desktop" 2>/dev/null || true
  fi
done

echo -e "${GREEN}[✓] Universal 'ai' terminal tool and Desktop AI Launcher updated.${RESET}"

# TIER 3.5: Dual Desktop Environments (XFCE & i3) & Login Greeter
echo ""
echo -e "${CYAN}${BOLD}[*] Configuring Dual Desktops (XFCE & i3) & Login Greeter...${RESET}"

# Ensure i3, status bar, and app menu are installed
if ! command -v i3 >/dev/null 2>&1; then
  echo -e "${CYAN}  -> Installing i3 window manager & menu utilities...${RESET}"
  apt-get update -qq
  apt-get install -y --no-install-recommends i3 i3status dmenu feh
fi

# 1. Provide dedicated fast session switchers
cat << 'I3_SW_EOF' > /usr/local/bin/switch-to-i3
#!/bin/bash
# Switch current active session to i3 Tiling Window Manager
if pgrep -x xfwm4 >/dev/null 2>&1; then
  pkill -9 xfdesktop 2>/dev/null || true
  pkill -9 xfce4-panel 2>/dev/null || true
  pkill -9 xfwm4 2>/dev/null || true
  exec i3 &
else
  exec i3 &
fi
I3_SW_EOF
chmod +x /usr/local/bin/switch-to-i3

cat << 'XFCE_SW_EOF' > /usr/local/bin/switch-to-xfce
#!/bin/bash
# Switch current active session to XFCE Graphical Desktop
pkill -9 i3 2>/dev/null || true
exec xfce4-session &
XFCE_SW_EOF
chmod +x /usr/local/bin/switch-to-xfce

# 2. Desktop entries for application menus and desktop shortcuts
cat << 'DESK_I3_EOF' > /usr/share/applications/switch-to-i3.desktop
[Desktop Entry]
Version=1.0
Type=Application
Name=Switch to i3 Window Manager
Comment=Switch current desktop session to i3 tiling window manager
Exec=/usr/local/bin/switch-to-i3
Icon=window-manager
Terminal=false
StartupNotify=true
Categories=System;Utility;
DESK_I3_EOF

cat << 'DESK_XFCE_EOF' > /usr/share/applications/switch-to-xfce.desktop
[Desktop Entry]
Version=1.0
Type=Application
Name=Switch to XFCE Desktop
Comment=Switch current desktop session to XFCE graphical desktop
Exec=/usr/local/bin/switch-to-xfce
Icon=xfce4-logo
Terminal=false
StartupNotify=true
Categories=System;Utility;
DESK_XFCE_EOF

# 3. Deploy Switch_to_i3.desktop to all user desktops
for ddir in /etc/skel/Desktop /root/Desktop /home/*/Desktop; do
  if [ -d "$ddir" ]; then
    cp /usr/share/applications/switch-to-i3.desktop "$ddir/Switch_to_i3.desktop"
    cp /usr/share/applications/switch-to-xfce.desktop "$ddir/Switch_to_XFCE.desktop"
    chmod +x "$ddir/Switch_to_i3.desktop" "$ddir/Switch_to_XFCE.desktop"
    u_owner=$(stat -c '%u:%g' "$ddir" 2>/dev/null || echo "1000:1000")
    chown "$u_owner" "$ddir/Switch_to_i3.desktop" "$ddir/Switch_to_XFCE.desktop" 2>/dev/null || true
  fi
done

# 4. Disable live autologin and purge live-config so LightDM greeter displays on boot
echo -e "${CYAN}  -> Configuring LightDM login screen (enabling user/session picker)...${RESET}"
# Purge Debian live-config daemon if present so it cannot recreate autologin on reboot
apt-get purge -y live-boot live-boot-doc live-config live-config-doc live-config-systemd live-tools 2>/dev/null || true
systemctl disable live-config.service 2>/dev/null || true
systemctl mask live-config.service 2>/dev/null || true
rm -rf /lib/live /var/lib/live

# Remove all autologin conf overrides
rm -f /etc/lightdm/lightdm.conf.d/*autologin*.conf
rm -f /etc/lightdm/lightdm.conf.d/*live*.conf
rm -f /etc/lightdm/lightdm.conf.d/*debian*.conf
rm -f /usr/share/lightdm/lightdm.conf.d/*live*.conf
rm -f /usr/share/lightdm/lightdm.conf.d/*autologin*.conf

# Comment out any autologin lines in lightdm configs
sed -i -E 's/^[[:space:]]*autologin-user[[:space:]]*=.*/#autologin-user=/' /etc/lightdm/lightdm.conf 2>/dev/null || true
sed -i -E 's/^[[:space:]]*autologin-user-timeout[[:space:]]*=.*/#autologin-user-timeout=/' /etc/lightdm/lightdm.conf 2>/dev/null || true
for cf in /etc/lightdm/lightdm.conf.d/*.conf /usr/share/lightdm/lightdm.conf.d/*.conf; do
  if [ -f "$cf" ]; then
    sed -i -E 's/^[[:space:]]*autologin-user[[:space:]]*=.*/#autologin-user=/' "$cf" 2>/dev/null || true
    sed -i -E 's/^[[:space:]]*autologin-user-timeout[[:space:]]*=.*/#autologin-user-timeout=/' "$cf" 2>/dev/null || true
  fi
done

# Explicitly configure LightDM greeter to show user list and session picker
mkdir -p /etc/lightdm/lightdm.conf.d
cat << 'GREETER_EOF' > /etc/lightdm/lightdm.conf.d/01-revenant-greeter.conf
[Seat:*]
autologin-user=
autologin-guest=false
greeter-session=lightdm-gtk-greeter
greeter-hide-users=false
greeter-show-manual-login=true
user-session=xfce
GREETER_EOF

# Ensure registered session files exist for both XFCE and i3 in LightDM
mkdir -p /usr/share/xsessions
cat << 'I3_XSESSION' > /usr/share/xsessions/i3.desktop
[Desktop Entry]
Name=i3
Comment=improved dynamic tiling window manager
Exec=i3
TryExec=i3
Type=Application
DesktopNames=i3
Keywords=tiling;wm;windowmanager;window;manager;
I3_XSESSION

if [ ! -f /usr/share/xsessions/xfce.desktop ] && [ -f /usr/share/xsessions/xubuntu.desktop ]; then
  cp /usr/share/xsessions/xubuntu.desktop /usr/share/xsessions/xfce.desktop
fi

echo -e "${GREEN}[✓] Dual desktop environments (XFCE / i3) & LightDM login greeter configured.${RESET}"

# TIER 4: Offline Neural TTS (Piper)
echo ""
echo -e "${CYAN}${BOLD}[4/5] Verifying Offline Neural Speech Synthesis (Piper)...${RESET}"
mkdir -p /opt/piper/models
if [ ! -f /opt/piper/models/en_US-lessac-medium.onnx ]; then
  echo -e "${CYAN}  -> Downloading neural voice model...${RESET}"
  curl -fsSL -o /opt/piper/models/en_US-lessac-medium.onnx https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/en/en_US/lessac/medium/en_US-lessac-medium.onnx || true
  curl -fsSL -o /opt/piper/models/en_US-lessac-medium.onnx.json https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/en/en_US/lessac/medium/en_US-lessac-medium.onnx.json || true
fi
echo -e "${GREEN}[✓] Offline neural speech synthesis verified.${RESET}"

# TIER 5: Upstream Security & Drivers
echo ""
echo -e "${CYAN}${BOLD}[5/5] Checking Hardware Drivers & Security Patches...${RESET}"
if dmidecode 2>/dev/null | grep -iq "Panasonic"; then
  modprobe panasonic-laptop 2>/dev/null || true
fi

# Ensure kernel config exists so update-initramfs never fails on missing CONFIG_RD_*
for kimg in /boot/vmlinuz-*; do
  if [ -f "$kimg" ]; then
    kver=$(basename "$kimg" | sed 's/^vmlinuz-//')
    kcfg="/boot/config-$kver"
    if [ ! -f "$kcfg" ]; then
      cat << 'CFG_EOF' > "$kcfg"
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=y
CONFIG_RD_LZMA=y
CONFIG_RD_XZ=y
CONFIG_RD_LZO=y
CONFIG_RD_LZ4=y
CONFIG_RD_ZSTD=y
CFG_EOF
    fi
  fi
done
if [ -n "$(uname -r 2>/dev/null)" ] && [ ! -f "/boot/config-$(uname -r)" ]; then
  cat << 'CFG_EOF' > "/boot/config-$(uname -r)"
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=y
CONFIG_RD_LZMA=y
CONFIG_RD_XZ=y
CONFIG_RD_LZO=y
CONFIG_RD_LZ4=y
CONFIG_RD_ZSTD=y
CFG_EOF
fi

if [ -f /usr/sbin/update-initramfs.orig.initramfs-tools ]; then
  dpkg-divert --remove --rename /usr/sbin/update-initramfs 2>/dev/null || true
  if [ ! -f /usr/sbin/update-initramfs ] && [ -f /usr/sbin/update-initramfs.orig.initramfs-tools ]; then
    cp -a /usr/sbin/update-initramfs.orig.initramfs-tools /usr/sbin/update-initramfs
  fi
  chmod +x /usr/sbin/update-initramfs 2>/dev/null || true
fi

# Unstick any pending dpkg triggers before package management
dpkg --configure -a 2>/dev/null || true

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get upgrade -y -qq || true
apt-get autoremove -y -qq || true
echo -e "${GREEN}[✓] Security packages and hardware profiles synchronized.${RESET}"

# Update GRUB boot menu title to display current release
if [ -f /boot/grub/grub.cfg ]; then
  echo -e "${CYAN}[*] Updating GRUB bootloader menu title...${RESET}"
  sed -i -E 's/Revenant OS V[0-9.]+/Revenant OS V15.6/g' /boot/grub/grub.cfg 2>/dev/null || true
  echo -e "${GREEN}[✓] GRUB bootloader title updated to Revenant OS V15.6.${RESET}"
fi

cat << EOF > "$LOCAL_VERSION_FILE"
{
  "os_name": "Revenant OS",
  "version": "$REMOTE_VER",
  "build": "$REMOTE_BUILD",
  "local_inference": {
    "engine": "llama-server",
    "model": "qwen2.5-coder-1.5b-instruct-q4_k_m.gguf",
    "port": 8080,
    "context_size": 2048
  },
  "agent_core": {
    "openviking": "active",
    "open_interpreter": "latest",
    "hermes_agent": "latest"
  },
  "last_updated": "$(date -Iseconds)"
}
EOF

echo ""
echo -e "${GREEN}${BOLD}==========================================================${RESET}"
echo -e "${GREEN}${BOLD}  [✓] REVENANT OS IS FULLY UP TO DATE (Build $REMOTE_BUILD)!  ${RESET}"
echo -e "${GREEN}${BOLD}==========================================================${RESET}"
echo ""
