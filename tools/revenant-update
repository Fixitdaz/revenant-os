#!/bin/bash
# ==============================================================================
# Revenant OS - Intelligent Over-The-Air (OTA) System & Agent Updater
# ==============================================================================
# Upgrades:
#   1. Agent Core (OmniRoute, OpenInterpreter, OpenViking, Hermes Agent)
#   2. Offline Neural TTS Voice Models (Piper)
#   3. System Scripts, Themes, Plymouth Splash, and Desktop Configurations
#   4. Upstream Linux Kernel & Security Patches
# ==============================================================================

# Disable strict exit-on-error so non-critical sub-commands never abort the update pipeline
set +e

REPO_OWNER="Fixitdaz"
REPO_NAME="revenant-os"
LOCAL_VERSION_FILE="/etc/revenant/version.json"
LOCAL_CHANNEL_FILE="/etc/revenant/channel"

# Channel detection: default to stable unless configured otherwise
CHANNEL="stable"
if [ -f "$LOCAL_CHANNEL_FILE" ]; then
  CHANNEL=$(cat "$LOCAL_CHANNEL_FILE" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
fi
if [ "$CHANNEL" != "beta" ]; then
  CHANNEL="stable"
fi

CYAN="\033[96m"
GREEN="\033[92m"
YELLOW="\033[93m"
RED="\033[91m"
RESET="\033[0m"
BOLD="\033[1m"

echo -e "${CYAN}${BOLD}"
echo "=========================================================="
echo "           REVENANT OS - SYSTEM & AGENT UPDATER           "
echo "=========================================================="
echo -e "${RESET}"

if [ "$EUID" -ne 0 ]; then
  echo -e "${RED}[!] Please run as root: sudo revenant-update${RESET}"
  exit 1
fi

CHECK_ONLY=false
FORCE=false

for arg in "$@"; do
  case "$arg" in
    --beta|-b)
      CHANNEL="beta"
      mkdir -p /etc/revenant
      echo "beta" > "$LOCAL_CHANNEL_FILE"
      echo -e "${YELLOW}[*] Switched update channel to: ${BOLD}BETA${RESET}"
      ;;
    --stable|-s)
      CHANNEL="stable"
      mkdir -p /etc/revenant
      echo "stable" > "$LOCAL_CHANNEL_FILE"
      echo -e "${GREEN}[*] Switched update channel to: ${BOLD}STABLE${RESET}"
      ;;
    --check|-c)
      CHECK_ONLY=true
      ;;
    --force|-f)
      FORCE=true
      ;;
    --help|-h)
      echo "Usage: sudo revenant-update [OPTIONS]"
      echo ""
      echo "Options:"
      echo "  -b, --beta     Switch to BETA channel (test experimental builds)"
      echo "  -s, --stable   Switch to STABLE channel (verified public releases)"
      echo "  -c, --check    Check for available updates without applying them"
      echo "  -f, --force    Force re-application of all updates and agent dependencies"
      echo "  -h, --help     Show this help message"
      exit 0
      ;;
  esac
done

TARGET_BRANCH="main"
if [ "$CHANNEL" = "beta" ]; then
  TARGET_BRANCH="beta"
fi

RAW_BASE="https://raw.githubusercontent.com/$REPO_OWNER/$REPO_NAME/$TARGET_BRANCH"
RAW_FALLBACK="https://github.com/$REPO_OWNER/$REPO_NAME/raw/$TARGET_BRANCH"

echo -e "${CYAN}[*] Testing internet connectivity...${RESET}"
if ! curl -s --head --connect-timeout 5 https://github.com >/dev/null; then
  echo -e "${RED}[!] Internet connection failed. Please connect to a network and try again.${RESET}"
  exit 1
fi
echo -e "${GREEN}[✓] Online connection verified.${RESET}"

# Self-update check: ensure the OTA updater script is always running the latest version from GitHub
if [ "$REVENANT_UPDATED" != "1" ]; then
  echo -e "${CYAN}[*] Checking for latest OTA updater script from GitHub...${RESET}"
  if curl -fsSL -H "Cache-Control: no-cache" --connect-timeout 5 "$RAW_BASE/tools/revenant-update" -o /tmp/revenant-update.new 2>/dev/null || \
     curl -fsSL -L -H "Cache-Control: no-cache" --connect-timeout 5 "$RAW_FALLBACK/tools/revenant-update" -o /tmp/revenant-update.new 2>/dev/null; then
    if [ -s /tmp/revenant-update.new ] && ! cmp -s /tmp/revenant-update.new "/usr/local/bin/revenant-update" 2>/dev/null; then
      cp /tmp/revenant-update.new /usr/local/bin/revenant-update
      chmod +x /usr/local/bin/revenant-update
      rm -f /tmp/revenant-update.new
      echo -e "${GREEN}[✓] OTA updater updated itself to latest release. Re-executing...${RESET}"
      export REVENANT_UPDATED=1
      exec /usr/local/bin/revenant-update "$@"
    fi
  fi
  rm -f /tmp/revenant-update.new
fi

mkdir -p /etc/revenant
if [ ! -f "$LOCAL_VERSION_FILE" ]; then
  cat << 'EOF' > "$LOCAL_VERSION_FILE"
{
  "os_name": "Revenant OS",
  "version": "1.0.0",
  "build": "17",
  "release_date": "2026-09-06"
}
EOF
fi

CURRENT_VER=$(grep -oP '"version":\s*"\K[^"]+' "$LOCAL_VERSION_FILE" 2>/dev/null || echo "1.0.0")
CURRENT_BUILD=$(grep -oP '"build":\s*"?\K[0-9]+(\.[0-9]+)?' "$LOCAL_VERSION_FILE" 2>/dev/null || echo "17")

echo -e "${CYAN}[*] Update Channel:            ${BOLD}${CHANNEL^^}${RESET} (${CYAN}branch: $TARGET_BRANCH${RESET})"
echo -e "${CYAN}[*] Current Installed Version: ${BOLD}v$CURRENT_VER (Build $CURRENT_BUILD)${RESET}"
echo -e "${CYAN}[*] Querying remote release manifest from GitHub ($TARGET_BRANCH)...${RESET}"

REMOTE_MANIFEST=$(curl -fsSL -H "Cache-Control: no-cache" --connect-timeout 10 "$RAW_BASE/version.json" 2>/dev/null || \
                  curl -fsSL -L -H "Cache-Control: no-cache" --connect-timeout 10 "$RAW_FALLBACK/version.json" 2>/dev/null || true)

if [ -z "$REMOTE_MANIFEST" ]; then
  echo -e "${YELLOW}[!] Could not fetch remote manifest (repository may be private or offline).${RESET}"
  echo -e "${CYAN}[*] Proceeding with live component synchronization mode...${RESET}"
  REMOTE_BUILD="$CURRENT_BUILD"
else
  REMOTE_VER=$(echo "$REMOTE_MANIFEST" | grep -oP '"version":\s*"\K[^"]+' 2>/dev/null || echo "$CURRENT_VER")
  REMOTE_BUILD=$(echo "$REMOTE_MANIFEST" | grep -oP '"build":\s*"?\K[0-9]+(\.[0-9]+)?' 2>/dev/null || echo "$CURRENT_BUILD")
  echo -e "${CYAN}[*] Latest Remote Version:    ${BOLD}v$REMOTE_VER (Build $REMOTE_BUILD)${RESET}"
fi

if [ "$CHECK_ONLY" = true ]; then
  if [ "$REMOTE_BUILD" != "$CURRENT_BUILD" ]; then
    echo -e "${GREEN}[✓] A new update is available: Build $REMOTE_BUILD (Installed: $CURRENT_BUILD)${RESET}"
    echo -e "Run 'sudo revenant-update' to install."
    exit 0
  else
    echo -e "${GREEN}[✓] System is up to date.${RESET}"
    exit 0
  fi
fi

# TIER 0: Login Greeter & Desktop Account Selection (Purge Stuck Autologin)
echo ""
echo -e "${CYAN}${BOLD}[0/5] Configuring LightDM Login Screen & Account Selection...${RESET}"
# Purge Debian live-config daemon so it cannot force or regenerate autologin on reboot
apt-get purge -y live-boot live-boot-doc live-config live-config-doc live-config-systemd live-tools 2>/dev/null || true
systemctl disable live-config.service 2>/dev/null || true
systemctl mask live-config.service 2>/dev/null || true
rm -rf /lib/live /var/lib/live

# Remove all autologin conf overrides
rm -f /etc/lightdm/lightdm.conf.d/*autologin*.conf
rm -f /etc/lightdm/lightdm.conf.d/*live*.conf
rm -f /etc/lightdm/lightdm.conf.d/*debian*.conf
rm -f /usr/share/lightdm/lightdm.conf.d/*live*.conf
rm -f /usr/share/lightdm/lightdm.conf.d/*autologin*.conf

# Comment out any autologin lines in lightdm configs
sed -i -E 's/^[[:space:]]*autologin-user[[:space:]]*=.*/#autologin-user=/' /etc/lightdm/lightdm.conf 2>/dev/null || true
sed -i -E 's/^[[:space:]]*autologin-user-timeout[[:space:]]*=.*/#autologin-user-timeout=/' /etc/lightdm/lightdm.conf 2>/dev/null || true
for cf in /etc/lightdm/lightdm.conf.d/*.conf /usr/share/lightdm/lightdm.conf.d/*.conf; do
  if [ -f "$cf" ]; then
    sed -i -E 's/^[[:space:]]*autologin-user[[:space:]]*=.*/#autologin-user=/' "$cf" 2>/dev/null || true
    sed -i -E 's/^[[:space:]]*autologin-user-timeout[[:space:]]*=.*/#autologin-user-timeout=/' "$cf" 2>/dev/null || true
  fi
done

# Explicitly configure LightDM greeter to show user list, session picker, and Revenant branding
mkdir -p /etc/lightdm/lightdm.conf.d /etc/lightdm/lightdm-gtk-greeter.conf.d /usr/share/backgrounds /usr/share/images/desktop-base /usr/share/icons

# Purge any Debian greeter config overrides so they cannot override Revenant settings
rm -f /etc/lightdm/lightdm-gtk-greeter.conf.d/*debian*.conf 2>/dev/null || true
rm -f /usr/share/lightdm/lightdm-gtk-greeter.conf.d/*debian*.conf 2>/dev/null || true
rm -f /etc/lightdm/lightdm-gtk-greeter.conf.d/01-revenant.conf 2>/dev/null || true

# Download or install Revenant wallpaper & boot splash if missing
if [ ! -f /usr/share/backgrounds/revenant_bootsplash.png ] || [ "$FORCE" = true ]; then
  curl -fsSL -o /usr/share/backgrounds/revenant_bootsplash.png \
    "https://raw.githubusercontent.com/$REPO_OWNER/$REPO_NAME/$TARGET_BRANCH/revenant_bootsplash.png" 2>/dev/null || true
fi
if [ ! -f /usr/share/backgrounds/revenant_wallpaper.jpg ] || [ "$FORCE" = true ]; then
  curl -fsSL -o /usr/share/backgrounds/revenant_wallpaper.jpg \
    "https://raw.githubusercontent.com/$REPO_OWNER/$REPO_NAME/$TARGET_BRANCH/revenant_wallpaper.jpg" 2>/dev/null || true
fi

# Deploy Revenant "R" Logo & Avatar for LightDM login box
if [ ! -f /usr/share/icons/revenant-logo.png ] || [ "$FORCE" = true ]; then
  curl -fsSL -o /usr/share/icons/revenant-logo.png \
    "https://raw.githubusercontent.com/$REPO_OWNER/$REPO_NAME/$TARGET_BRANCH/revenant_logo.png" 2>/dev/null || true
fi

# Fallback base64 generation of Revenant "R" logo if download was empty
if [ ! -s /usr/share/icons/revenant-logo.png ]; then
  cat << 'B64_LOGO' | base64 -d > /usr/share/icons/revenant-logo.png

B64_LOGO
fi
cp -f /usr/share/icons/revenant-logo.png /usr/share/icons/revenant-avatar.png 2>/dev/null || true

# Completely overwrite Debian default avatars and all user account avatars with Revenant 'R' badge
mkdir -p /usr/share/images/desktop-base /usr/share/icons/desktop-base /etc/skel /root

# Overwrite desktop-base default avatar
for av_dest in /usr/share/images/desktop-base/avatar.png /usr/share/icons/desktop-base/avatar.png \
               /usr/share/images/desktop-base/avatar.svg /usr/share/icons/desktop-base/avatar.svg; do
  cp -f /usr/share/icons/revenant-logo.png "$av_dest" 2>/dev/null || true
done

# Overwrite default skel and root avatars
cp -f /usr/share/icons/revenant-logo.png /etc/skel/.face 2>/dev/null || true
cp -f /usr/share/icons/revenant-logo.png /etc/skel/.face.icon 2>/dev/null || true
cp -f /usr/share/icons/revenant-logo.png /root/.face 2>/dev/null || true
cp -f /usr/share/icons/revenant-logo.png /root/.face.icon 2>/dev/null || true

# Overwrite all existing user avatars in /home/* (e.g. /home/delbert, /home/revenant, /home/user)
for uhome in /home/*; do
  if [ -d "$uhome" ]; then
    cp -f /usr/share/icons/revenant-logo.png "$uhome/.face" 2>/dev/null || true
    cp -f /usr/share/icons/revenant-logo.png "$uhome/.face.icon" 2>/dev/null || true
    u_owner=$(stat -c '%u:%g' "$uhome" 2>/dev/null || echo "1000:1000")
    chown "$u_owner" "$uhome/.face" "$uhome/.face.icon" 2>/dev/null || true
  fi
done

# Overwrite AccountsService avatar cache
if [ -d /var/lib/AccountsService/icons ]; then
  for icon_file in /var/lib/AccountsService/icons/*; do
    if [ -f "$icon_file" ]; then
      cp -f /usr/share/icons/revenant-logo.png "$icon_file" 2>/dev/null || true
    fi
  done
fi
if [ -d /var/lib/AccountsService/users ]; then
  for user_file in /var/lib/AccountsService/users/*; do
    if [ -f "$user_file" ]; then
      sed -i -E 's|^Icon=.*|Icon=/usr/share/icons/revenant-avatar.png|' "$user_file" 2>/dev/null || true
      if ! grep -q "^Icon=" "$user_file" 2>/dev/null; then
        echo "Icon=/usr/share/icons/revenant-avatar.png" >> "$user_file"
      fi
    fi
  done
fi

# Override Debian desktop-base symlinks and login backgrounds with Revenant artwork
if [ -f /usr/share/backgrounds/revenant_bootsplash.png ]; then
  cp -f /usr/share/backgrounds/revenant_bootsplash.png /usr/share/images/desktop-base/desktop-background 2>/dev/null || true
  cp -f /usr/share/backgrounds/revenant_bootsplash.png /usr/share/images/desktop-base/login-background.svg 2>/dev/null || true
  cp -f /usr/share/backgrounds/revenant_bootsplash.png /boot/grub/splash.png 2>/dev/null || true
  update-alternatives --install /usr/share/images/desktop-base/desktop-background desktop-background /usr/share/backgrounds/revenant_bootsplash.png 100 2>/dev/null || true
  update-alternatives --set desktop-background /usr/share/backgrounds/revenant_bootsplash.png 2>/dev/null || true
fi

# Neutralize vendor Debian logo icons with the Revenant badge
for deb_icon in /usr/share/icons/desktop-base/debian.svg \
               /usr/share/icons/desktop-base/debian-logo.svg \
               /usr/share/icons/desktop-base/*debian*.svg \
               /usr/share/icons/desktop-base/*debian*.png \
               /usr/share/icons/hicolor/scalable/apps/debian-logo.svg \
               /usr/share/icons/hicolor/*/apps/debian*.png \
               /usr/share/icons/hicolor/*/apps/debian*.svg; do
  if [ -f "$deb_icon" ]; then
    cp -f /usr/share/icons/revenant-logo.png "$deb_icon" 2>/dev/null || true
  fi
done

cat << 'GREETER_EOF' > /etc/lightdm/lightdm.conf.d/01-revenant-greeter.conf
[Seat:*]
autologin-user=
autologin-guest=false
greeter-session=lightdm-gtk-greeter
greeter-hide-users=false
greeter-show-manual-login=true
user-session=xfce
GREETER_EOF

cat << 'GREETER_CONF_EOF' > /etc/lightdm/lightdm-gtk-greeter.conf.d/99_revenant.conf
[greeter]
background = /usr/share/backgrounds/revenant_bootsplash.png
theme-name = Adwaita-dark
icon-theme-name = Papirus-Dark
cursor-theme-name = Adwaita
font-name = Sans 10
xft-antialias = true
xft-dpi = 96
xft-hintstyle = slight
xft-rgba = rgb
indicators = ~host;~spacer;~clock;~spacer;~session;~power
clock-format = %a, %d %b  %H:%M
default-user-image = /usr/share/icons/revenant-avatar.png
logo = /usr/share/icons/revenant-logo.png
hide-user-image = false
GREETER_CONF_EOF

# Also update /etc/lightdm/lightdm-gtk-greeter.conf directly
cat << 'GREETER_MAIN_EOF' > /etc/lightdm/lightdm-gtk-greeter.conf
[greeter]
background = /usr/share/backgrounds/revenant_bootsplash.png
theme-name = Adwaita-dark
icon-theme-name = Papirus-Dark
cursor-theme-name = Adwaita
font-name = Sans 10
xft-antialias = true
xft-dpi = 96
xft-hintstyle = slight
xft-rgba = rgb
indicators = ~host;~spacer;~clock;~spacer;~session;~power
clock-format = %a, %d %b  %H:%M
default-user-image = /usr/share/icons/revenant-avatar.png
logo = /usr/share/icons/revenant-logo.png
hide-user-image = false
GREETER_MAIN_EOF

# Ensure registered session files exist for both XFCE and i3 in LightDM
mkdir -p /usr/share/xsessions
cat << 'I3_XSESSION' > /usr/share/xsessions/i3.desktop
[Desktop Entry]
Name=i3
Comment=improved dynamic tiling window manager
Exec=i3
TryExec=i3
Type=Application
DesktopNames=i3
Keywords=tiling;wm;windowmanager;window;manager;
I3_XSESSION

if [ ! -f /usr/share/xsessions/xfce.desktop ] && [ -f /usr/share/xsessions/xubuntu.desktop ]; then
  cp /usr/share/xsessions/xubuntu.desktop /usr/share/xsessions/xfce.desktop
fi

echo -e "${GREEN}[✓] LightDM login screen restored: prompt for user selection and desktop session on startup.${RESET}"

# TIER 1: Offline Local Inference Engine (llama-server & Qwen 2.5)
echo ""
echo -e "${CYAN}${BOLD}[1/5] Configuring Offline Local Inference Engine...${RESET}"
mkdir -p /opt/llama.cpp /opt/models

if [ ! -f /opt/llama.cpp/llama-server ] || [ "$FORCE" = true ]; then
  echo -e "${CYAN}  -> Downloading static llama-server binary...${RESET}"
  mkdir -p /tmp/llama_bin
  curl -fsSL -o /tmp/llama_bin/llama-server.tar.gz https://github.com/ggerganov/llama.cpp/releases/download/b10816/llama-b10816-bin-ubuntu-x64.tar.gz || true
  if [ -f /tmp/llama_bin/llama-server.tar.gz ]; then
    tar -xzf /tmp/llama_bin/llama-server.tar.gz -C /tmp/llama_bin/ || true
    find /tmp/llama_bin -name "llama-server" -exec cp {} /opt/llama.cpp/llama-server \; || true
    chmod +x /opt/llama.cpp/llama-server || true
    rm -rf /tmp/llama_bin
  fi
fi

if [ ! -f /opt/models/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf ] || [ "$FORCE" = true ]; then
  echo -e "${CYAN}  -> Downloading Qwen2.5-Coder-1.5B (Q4_K_M GGUF, ~1.04GB)...${RESET}"
  curl -L --progress-bar -o /opt/models/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf \
    https://huggingface.co/Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF/resolve/main/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf || true
fi

cat << 'SVCEOF' > /etc/systemd/system/llama-server.service
[Unit]
Description=Revenant OS Local Llama Inference Server
After=network.target
StartLimitBurst=0

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/opt/llama.cpp
ExecStart=/opt/llama.cpp/llama-server --model /opt/models/qwen2.5-coder-1.5b-instruct-q4_k_m.gguf --alias qwen2.5-coder-1.5b-instruct --host 127.0.0.1 --port 8080 --ctx-size 4096 --threads 2 -np 1 --no-cache-prompt -sps 0 --n-gpu-layers 0
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
SVCEOF

pkill -9 -f llama-server 2>/dev/null || true
systemctl daemon-reload
systemctl enable llama-server.service 2>/dev/null || true
systemctl restart llama-server.service 2>/dev/null || true
echo -e "${GREEN}[✓] Local inference server configured on http://127.0.0.1:8080/v1 (4K context, no-cache-prompt, fast CPU golden config)${RESET}"

# Rewrite revenant-services desktop launcher script (fixes truncation bugs from V15.7 and earlier)
echo -e "${CYAN}  -> Updating AI Engine desktop launcher script...${RESET}"
cat << 'STARTEOF' > /usr/local/bin/revenant-services
#!/bin/bash
# ==============================================================================
# Revenant OS - Local AI Engine & Background Services Controller
# ==============================================================================

CYAN="\033[96m"
GREEN="\033[92m"
YELLOW="\033[93m"
RED="\033[91m"
RESET="\033[0m"
BOLD="\033[1m"

clear
echo -e "${CYAN}${BOLD}"
echo "=========================================================="
echo "    REVENANT OS - LOCAL AI ENGINE & BACKGROUND STACK     "
echo "=========================================================="
echo -e "${RESET}"

echo -e "${CYAN}[*] Checking & Restarting llama-server.service...${RESET}"
sudo systemctl daemon-reload
sudo systemctl restart llama-server.service 2>/dev/null || sudo systemctl start llama-server.service 2>/dev/null || true

echo -e "${CYAN}[*] Checking & Restarting openviking.service...${RESET}"
sudo systemctl restart openviking.service 2>/dev/null || sudo systemctl start openviking.service 2>/dev/null || true

echo -e "${CYAN}[*] Waiting for local model endpoint (http://127.0.0.1:8080/v1)...${RESET}"
echo -e "${CYAN}    (Loading 1.1GB model on Toughbook CPU — this can take up to 90 seconds)${RESET}"
READY=false
for i in {1..90}; do
  if curl -s http://127.0.0.1:8080/v1/models >/dev/null 2>&1; then
    READY=true
    break
  fi
  sleep 1
  echo -n "."
done
echo ""

if [ "$READY" = true ]; then
  echo -e "${GREEN}${BOLD}[✓] Local AI Engine is ACTIVE and ready on port 8080!${RESET}"
else
  echo -e "${YELLOW}[!] llama-server has not responded yet. Checking logs...${RESET}"
  echo ""
  sudo journalctl -u llama-server -n 10 --no-pager 2>/dev/null || true
  echo ""
  echo -e "${YELLOW}    If it says 'Illegal instruction' the binary may not support this CPU.${RESET}"
  echo -e "${YELLOW}    If it says 'model not found' run: sudo revenant-update --force${RESET}"
fi

echo ""
echo -e "${CYAN}${BOLD}Service Status Overview:${RESET}"
echo -n "  • llama-server: "
systemctl is-active llama-server.service
echo -n "  • openviking:   "
systemctl is-active openviking.service

echo ""
echo -e "${GREEN}${BOLD}How to interact with your local AI:${RESET}"
echo -e "  1. Universal CLI:     ${BOLD}ai \"What is the IP address of this machine?\"${RESET}"
echo -e "  2. Revenant Agent:    ${BOLD}revenant-agent${RESET} (or simply ${BOLD}ai${RESET})"
echo -e "  3. OpenInterpreter:   ${BOLD}interpreter${RESET}"
echo ""
echo -e "Press [Enter] to launch an interactive Revenant Agent session, or Ctrl+C to exit..."
read -r
revenant-agent
STARTEOF
chmod +x /usr/local/bin/revenant-services
echo -e "${GREEN}[✓] Desktop AI launcher script updated.${RESET}"

# TIER 2: OpenViking Memory Daemon & Agent Core
echo ""
echo -e "${CYAN}${BOLD}[2/5] Priming OpenViking Context Memory & Agent Stack...${RESET}"
# Fast bounded check for agent packages without locking indefinitely
if timeout 15s pip3 install --break-system-packages --upgrade open-interpreter openviking >/dev/null 2>&1; then
  echo -e "${GREEN}[✓] Python agent packages synchronized.${RESET}"
else
  echo -e "${YELLOW}[!] Fast package sync completed / using cached offline packages.${RESET}"
fi

cat << 'VKEOF' > /etc/systemd/system/openviking.service
[Unit]
Description=OpenViking Automated Agent Context & Memory Daemon
After=llama-server.service

[Service]
Type=simple
ExecStart=/usr/local/bin/ov daemon --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5
User=root
Environment=OPENAI_API_BASE=http://127.0.0.1:8080/v1
Environment=OPENAI_API_KEY=sk-local-revenant

[Install]
WantedBy=multi-user.target
VKEOF

systemctl daemon-reload
systemctl enable openviking.service 2>/dev/null || true
systemctl restart openviking.service 2>/dev/null || true

# Pre-configure environment defaults so Hermes and Interpreter use local llama-server
sed -i '/OPENAI_API_BASE/d' /etc/environment 2>/dev/null || true
sed -i '/OPENAI_API_KEY/d' /etc/environment 2>/dev/null || true
echo 'OPENAI_API_BASE="http://127.0.0.1:8080/v1"' >> /etc/environment
echo 'OPENAI_API_KEY="sk-local-revenant"' >> /etc/environment

# Purge OmniRoute and decommission cloud proxy services
echo -e "${CYAN}  -> Decommissioning OmniRoute cloud proxy & reclaiming RAM...${RESET}"
systemctl stop omniroute.service 2>/dev/null || true
systemctl disable omniroute.service 2>/dev/null || true
rm -f /etc/systemd/system/omniroute.service
pkill -9 -f omniroute 2>/dev/null || true
npm uninstall -g omniroute 2>/dev/null || true
rm -f /usr/local/bin/omniroute /usr/bin/omniroute
ufw delete allow 20128/tcp 2>/dev/null || true
echo -e "${GREEN}[✓] OmniRoute purged: port 20128 closed, service removed, RAM reclaimed.${RESET}"

# Purge Hermes Agent and stop any background Hermes processes
echo -e "${CYAN}  -> Decommissioning resource-heavy Hermes Agent & stopping background tasks...${RESET}"
